
DATABASE_URL="postgresql://postgres:postgre123@localhost:5432/portfolio-cms?schema=public"

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Auth.js
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-secure-random-secret"

# Optional: seed the first admin user (used by `pnpm seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Admin"